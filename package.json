{
  "name": "personal-context-protocol",
  "version": "0.1.0",
  "description": "PCP: an open, agent-agnostic personal context protocol with an on-device learned model, powered by Qloo.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZYLIM0702/personal-context-protocol.git"
  },
