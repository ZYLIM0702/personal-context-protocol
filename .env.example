# Copy to .env and fill in. Never commit .env.

# --- Qloo (required for taste scoring) ---
# Event credential. Alternatively run `qloo setup --qloo` on the host.
QLOO_API_KEY=
# Hackathon keys only work on the hackathon host. The server passes both values to `qloo mcp`;
# these are the defaults, change them only if Qloo tells you to.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# --- Agent model (the default is the first one configured: LLM_BASE_URL, OpenAI, Anthropic) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Local model (Ollama, LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# Any other OpenAI-compatible endpoint as the server-wide default
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# Let clients send a non-localhost agent.baseUrl (off by default; SSRF guard)
# PCP_ALLOW_CUSTOM_BASE_URL=1

# --- Storage ---
# Google Drive backup in the browser (OAuth web client ID, appDataFolder scope)
# GOOGLE_CLIENT_ID=

# --- Server ---
# PORT=8787
# Requests per minute per client on routes that call Qloo or the model
# PCP_RATE_LIMIT=20
# Set to 1 behind Cloudflare Tunnel or another reverse proxy so the rate limit uses the visitor's IP
# PCP_TRUST_PROXY=1
# Cross-origin browser access (comma-separated origins, or *). Default: same-origin only
# PCP_CORS_ORIGINS=
# Where the PC graph, demo history and vault live (default ./data)
# PCP_DATA_DIR=

# --- Hosted demo ---
# Only the server's own web page may call /v1/* (signed session cookie + same-origin); agent model fixed.
# Set this on the public demo so its OpenAI and Qloo keys can't be used by CLIs or other agents.
# PCP_DEMO_PAGE_ONLY=1
